// program 1.4 - Multiple Inheritance

#include <iostream>
using namespace std;


class Parent1 {
public:
    void giveMeMoneyByMother() {
        cout << "Mummy paise de do mujhe" << endl;
    }
};

class Parent2 {
public:
    void giveMeMoneyByFather() {
        cout << "Papa paise de do mujhe" << endl;
    }
};

class Child : public Parent1, public Parent2 {

};

int main() {

    Child obj1;

    obj1.giveMeMoneyByMother();
    obj1.giveMeMoneyByFather();

    return 0;
}
