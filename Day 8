// program 1.3 - Hierarchical inheritence 

#include <iostream>
using namespace std;

class Vehicle {
    public:
    void start () {
        cout << "Vehicle starts" << endl;
    }
    
};
class Bike : public Vehicle {
    public:
    void ride() {
        cout << "Bike is running" << endl;
    }
    
};

class Car : public Vehicle {
    public:
    void chalna() {
        cout << "Car is chilling" << endl;
    }
};

int main () {
    Car obj1;
    Bike obj2;
    
    obj1.start();
    obj1.chalna();
    
    obj2.ride();
}

