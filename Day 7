#include <iostream>
using namespace std;

class BankAccount {

private:
    int balance = 5000;
    
public:
void showBalance () {
    cout << "Balance in your account is :" << balance ;
    
}
};

int main () {
    BankAccount myaccount;
    myaccount.showBalance();
}
