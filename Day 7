// program 2
// access specifier - 7.3 protected

#include <iostream>
using namespace std;

class Parent {
    
protected:    
    int secretCode = 1234; 


};

class child : public Parent {
public:
    void accessOfSecretCode() {
        cout << "secretCode of locker is " << secretCode;
    }
};

int main () {
    child obj1;
    obj1.accessOfSecretCode();
}
