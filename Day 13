// Program 1 
// Recursion

#include<iostream>
using namespace std;

int consecutiveOnes(int n) {
    
    if(n==0){
        return 1;
    }
    
    if(n==1) {
        return 2;
    }
    
    if (n==2) {
        return 3;
    }
    return consecutiveOnes(n-1) + consecutiveOnes(n-2);
}

int main()
{
    cout << consecutiveOnes(10);
    
    return 0;
}
